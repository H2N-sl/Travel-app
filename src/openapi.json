{
  "openapi": "3.0.3",
  "info": {
    "title": "Serendib & Metshu DMC - 6-Stage Reservation Engine REST API",
    "description": "Production REST API specification for Destination Management Company (DMC) end-to-end travel reservation life cycle: Lead Intake -> Itinerary & Resources -> Costing & Quotation -> Invoicing & Payments -> Vouchers & QR -> Client Documents & Post-Trip.",
    "version": "2.0.0",
    "contact": {
      "name": "DMC Engineering Team",
      "email": "dev@metshutravels.com"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000/api/v1",
      "description": "Local Laravel API Server (v1)"
    },
    {
      "url": "/api",
      "description": "Current Origin / Mock Dev Server"
    }
  ],
  "paths": {
    "/bookings": {
      "get": {
        "summary": "Stage 1: List all reservations with current lifecycle stage and payment status",
        "tags": ["Stage 1 - Lead Intake"],
        "responses": {
          "200": {
            "description": "List of bookings"
          }
        }
      },
      "post": {
        "summary": "Stage 1: Initialize a new reservation draft and party record",
        "tags": ["Stage 1 - Lead Intake"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewBooking" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reservation initialized with booking reference"
          }
        }
      }
    },
    "/bookings/{id}/itinerary": {
      "put": {
        "summary": "Stage 2: Bulk update day-by-day itinerary destinations, hotels, room categories, and meal plans",
        "tags": ["Stage 2 - Itinerary & Resources"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "days": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/ItineraryDay" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Itinerary schedule updated" }
        }
      }
    },
    "/bookings/{id}/allocations": {
      "put": {
        "summary": "Stage 2: Assign vehicle fleet class and certified national chauffeur-guide",
        "tags": ["Stage 2 - Itinerary & Resources"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "transport_type": { "type": "string", "example": "Luxury AC Van (Toyota KDH)" },
                  "driver_guide": { "type": "string", "example": "Samantha Bandara (National Guide)" },
                  "driver_phone": { "type": "string", "example": "+94 77 123 4567" },
                  "driver_language": { "type": "string", "example": "English, German" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Fleet and chauffeur guide allocated" }
        }
      }
    },
    "/bookings/{id}/calculate-quote": {
      "post": {
        "summary": "Stage 3: Calculate gross tour pricing, net supplier costs, and dynamic DMC markup",
        "tags": ["Stage 3 - Costing & Quotation"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "markup_percentage": { "type": "number", "default": 25.0, "example": 25.0 },
                  "target_currency": { "type": "string", "enum": ["LKR", "USD", "EUR", "GBP"], "default": "LKR" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Quotation breakdown and gross totals calculated" }
        }
      }
    },
    "/bookings/{id}/payments": {
      "post": {
        "summary": "Stage 4: Log deposit or balance settlement transaction and advance payment status",
        "tags": ["Stage 4 - Invoicing & Payments"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "currency", "type", "method"],
                "properties": {
                  "amount": { "type": "number", "example": 855000 },
                  "currency": { "type": "string", "enum": ["LKR", "USD", "EUR", "GBP"], "example": "LKR" },
                  "type": { "type": "string", "enum": ["deposit", "balance", "full"], "example": "deposit" },
                  "method": { "type": "string", "enum": ["stripe", "payhere", "bank_transfer"], "example": "stripe" },
                  "reference": { "type": "string", "example": "ch_3N8912831" },
                  "notes": { "type": "string", "example": "30% initial deposit" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Payment logged, booking state updated" }
        }
      }
    },
    "/bookings/{id}/vouchers": {
      "get": {
        "summary": "Stage 5: Generate and retrieve hotel check-in vouchers, driver duty slips, and verification QR tokens",
        "tags": ["Stage 5 - Vouchers & QR"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "List of generated service vouchers with QR payloads"
          }
        }
      }
    },
    "/bookings/{id}/documents/{type}": {
      "get": {
        "summary": "Stage 6: Render automated client documents (Welcome Letter, Agreement, Post-trip Survey)",
        "tags": ["Stage 6 - Client Documents"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "type", "in": "path", "required": true, "schema": { "type": "string", "enum": ["quotation", "welcome_letter", "travel_agreement", "thank_you_survey"] } }
        ],
        "responses": {
          "200": { "description": "Rendered document HTML payload and metadata" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NewBooking": {
        "type": "object",
        "required": ["agent_id", "guest_name", "nationality", "pax_adults", "arrival_date", "departure_date", "transport_type"],
        "properties": {
          "agent_id": { "type": "integer", "example": 1 },
          "guest_name": { "type": "string", "example": "Lord & Lady Crawford" },
          "nationality": { "type": "string", "example": "British" },
          "pax_adults": { "type": "integer", "example": 2 },
          "pax_children": { "type": "integer", "example": 0 },
          "pax_infants": { "type": "integer", "example": 0 },
          "arrival_date": { "type": "string", "format": "date", "example": "2026-10-10" },
          "departure_date": { "type": "string", "format": "date", "example": "2026-10-17" },
          "transport_type": { "type": "string", "example": "Luxury AC Van (Toyota KDH)" },
          "revenue_lkr": { "type": "number", "example": 2850000 }
        }
      },
      "ItineraryDay": {
        "type": "object",
        "properties": {
          "day_number": { "type": "integer", "example": 1 },
          "date": { "type": "string", "format": "date", "example": "2026-10-10" },
          "destination": { "type": "string", "example": "Colombo" },
          "hotel_name": { "type": "string", "example": "Cinnamon Grand Colombo" },
          "room_category": { "type": "string", "example": "Premium Deluxe Sea View" },
          "meal_plan": { "type": "string", "enum": ["RO", "BB", "HB", "FB", "AI"], "example": "HB" },
          "activities": { "type": "string", "example": "Airport VIP greeting & Colombo City Tour" },
          "transport": { "type": "string", "example": "Luxury AC Van" }
        }
      }
    }
  }
}
